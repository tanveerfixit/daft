# ====================================================================
# EPOS NODE - HOSTINGER ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# --- Database Settings ---
# On Hostinger shared / cloud hosting where MySQL is on the same account:
# Use 'localhost' or '127.0.0.1'
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_epos_db
DB_USER=u123456789_db_user
DB_PASS=YourStrongDatabasePasswordHere

# --- SMTP Email Settings (Hostinger Business Mail) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=YourEmailPasswordHere
SMTP_FROM_NAME=Your Store EPOS
SMTP_FROM_EMAIL=noreply@yourdomain.com

# --- Application Server & Security ---
NODE_ENV=production
PORT=3000
JWT_SECRET=generate_a_random_secure_32_plus_char_secret_here
DEV_PASS=admin123
